{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import ./ts-resolve.mjs --test \"src/lib/*.test.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"../shared/*.ts\" \"../supabase/functions/**/*.ts\"",
